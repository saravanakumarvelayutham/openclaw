# Copy to .env and fill with your values.
# Keep this secret: users need this token as their OpenClaw provider apiKey.
OLLAMA_PROXY_TOKEN=replace-with-long-random-token

# Where Ollama listens from the proxy container.
# host.docker.internal works for Docker Desktop and Linux with host-gateway.
OLLAMA_UPSTREAM=host.docker.internal:11434

# Public or local listening port for the proxy.
OLLAMA_PROXY_PORT=11435
